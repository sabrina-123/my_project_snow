{
  "name": "shopnow-test-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ShopNow - plateforme pédagogique de tests logiciels avec Jenkins et SonarQube",
  "main": "app/src/server.js",
  "scripts": {
    "start": "node app/start.js",
    "test": "mocha \"tests/**/*.test.js\" --timeout 30000",
    "test:unit": "mocha \"tests/unit/**/*.test.js\" --timeout 10000",
    "test:integration": "mocha \"tests/integration/**/*.test.js\" --timeout 10000",
    "test:e2e": "mocha \"tests/e2e/**/*.test.js\" --timeout 30000",
    "test:coverage": "nyc --reporter=lcov --reporter=text mocha \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" --timeout 10000"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "chai": "^5.1.2",
    "geckodriver": "^6.1.1",
    "mocha": "^12.0.2",
    "nyc": "^18.0.0",
    "selenium-webdriver": "^4.28.1",
    "supertest": "^7.1.0"
  },
  "allowScripts": {
    "geckodriver@6.1.1": true
  }
}
